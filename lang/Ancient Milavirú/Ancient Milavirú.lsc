# IPA
Class c {t, p, ɾ, s, f, m, w, j, h, ʃ, n, k, l}
Class v {a, aː, iː, ə, uː, ɔ, ɛ, ɔː, ɛː, ɪ, ä, ɛ̈, ɒ}

v:
    ə => ɪ
    {a, ɛ, ɔ} => {ä, ɛ̈, ɒ}
    then: {äː, ɛ̈ː, ɒː} => {aː, eː, oː}
c:
    w => ʋ
    h => ʔ // $ _
    h => * / $ _
    s => s̠
    ʃ => s
    j => ʝ / @v _ @v
    then: {s̠ɾ, sɾ} => {s̠t, st}
