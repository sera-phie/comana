# IPA
Class c {s, ʋ, ʝ, ʔ, n, k, t, l, j, s̠, f, ɾ, p, m, d, b, h}
Class v {ɪ, uː, uːː, eː, aː, ɛ̈, iː, oː, ɒ, ä, ɔ, ɨ, ɛ, e}

v:
    {aː, eː, iː, oː, uː, ä, ɛ̈, ɪ, ɒ} => {a, e, i, ɔ, u, a, ɛ, ɨ, ɔ}
    then: ɨ => * / {ɾ, l, n, s} _ @c // _ @c $
    then: ɨ => * / {ɾ, l, n, s} _ $
    ː => *

c:
	ʔ => h
	{t, d} => ɾ / @v _ @v
	s̠ => s
	f => p
	ɾ => d / {$, @c} _
	ʋ => b / {$, @c} _
	l => n / {$, @c} _
	ʝ => ʃ
	then: ʋ => *
	then: s => ɨ / @c _ $
	then: (
		aɨ => ai
		ɾ => ʔ / _ $
		l => ʔ / _ {$, @c}
		p => ʔ / _ $
		then: ( 
			{ʔd, ʔb} => {ʔt, ʔp}
			ɨʔ => ɛʔ
			{ɛu, iɔ, uɔ} => {au, ɛa, ɔa}
			n => * / @c _ $
		)
	)
